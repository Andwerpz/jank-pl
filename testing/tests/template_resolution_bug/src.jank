#include <put>;
#include <vector>;
#include <iostream>;
#include <assert>;

// 7/10/2026

// currently, I wait to look for templated types in a function's signature and return type 
// until when I'm processing it in the work queue. 

// this leads to a bug like this: 
// func_a is called by func_b, and func_b is called by func_a. 
// suppose that func_a is processed first, it looks for templated types and discovers 'Foo<i32>'
// however, within the body it uses the type 'Foo<u32>' from func_b, which hasn't been discovered yet
// leading to a compilation error. 
// note that if func_b is processed first, the same issue arises. 

// I see a few ways of solving this:
// - when we add a function, immediately look for templates within its signature and return value
//   can defer looking for templates in the body until later. 
// - when we add a function (or really anything), immediately look for templates within it, including
//   its body. 

// I solved this by just immediately looking for templates when adding instantiated declarations. 

template<T>
struct Foo {
    Foo(T val) {
        this.bar = val;
    }

    T bar;
}

Foo<u32> func_b() {
    cout << "from func_a : " << func_a().bar << "\n";
    return new Foo<u32>($u32 10);
}

Foo<i32> func_a() {
    cout << "from func_b : " << func_b().bar << "\n";
    return  new Foo<i32>(10);
}

i32 main() {
    cout << "this should compile\n";
    return 0;
}