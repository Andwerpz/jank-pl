#include <iostream>;

i32 main() {

    u64 n = 0x100;
    i32* buf = $i32* intrinsic("malloc", n * sizeof(i32));
    for(u64 i = 0x0; i < n; i++) {
        buf[i] = $i32 ((i + 0x1) + (i * i));
    }
    for(u64 i = 0x0; i < n; i++) {
        cout << buf[i] << "\n";
    }
    intrinsic("free", $void* buf, n * sizeof(i32));
    
    return 0;
}