    stream.write_to_fd($u8* @(stream.scratch));
    return stream;
}

ostream& operator<<(ostream& stream, u32 x) {
    to_string(x, $u8* @(stream.scratch));
    stream.write_to_fd($u8* @(stream.scratch));
    return stream;
}

ostream& operator<<(ostream& stream, u16 x) {
    to_string(x, $u8* @(stream.scratch));
    stream.write_to_fd($u8* @(stream.scratch));
    return stream;
}

ostream& operator<<(ostream& stream, u8 c) {
    stream.write_to_fd(c);
    return stream;
}

ostream& operator<<(ostream& stream, f32 x) {
    stream.write_to_fd(to_string(x));
    return stream;
}

template<T>
ostream& operator<<(ostream& stream, T* ptr) {
    stream.write_to_fd("0x");
    u64 val = $u64 ptr;
    u64 mask = 0b1111;
    for(i32 i = 15; i >= 0; i--){
        u64 dig = (val & (mask << ($u64 i * $u64 4))) >> ($u64 i * $u64 4);
        u8 c;
        if(dig < $u64 10) {
            c = '0' + $u8 dig;
        }
        else {
            c = 'a' + $u8 dig - $u8 10;
        }
        stream.write_to_fd(c);
    }
    return stream;
}


// -- ADAPTERS --
// iostream is defining these because I don't want the containers themselves to depend on iostream
// ideally, iostream doesn't need to know about these containers either. 
// we can have both by making some sort of printing interface in core and having both adhere to the interface
// something like implementing iterators would solve this. 
ostream& operator<<(ostream& stream, string s) {
    stream.write_to_fd(s);
    return stream;
}

template<T, U>
ostream& operator<<(ostream& s, pair<T, U> p) {
    return s << "{" << p.first << ", " << p.second << "}";
}

ostream& operator<<(ostream& stream, u128 x) {
    stream << "0x";
    for(i32 i = 0; i < 32; i++) {
        i32 d = $i32 ((x.hi & (0xF << 0x3C)) >> 0x3C);
        if(d < 10) stream << ('0' + $u8 d);
        else stream << ('a' + $u8 (d - 10));
        x <<= 0x4;
    }
    return stream;
}

ostream& operator<<(ostream& stream, u256 x) {
    stream << "0x";
    for(i32 i = 0; i < 64; i++) {
        i32 d = $i32 ((x.hi.hi & (0xF << 0x3C)) >> 0x3C);
        if(d < 10) stream << ('0' + $u8 d);
        else stream << ('a' + $u8 (d - 10));
        x <<= 0x4;
    }
    return stream;
}

ostream& operator<<(ostream& stream, u512 x) {
    stream << "0x";
    for(i32 i = 0; i < 128; i++) {
        i32 d = $i32 ((($u64 x.limbs[7]) & (0xF << 0x3C)) >> 0x3C);
        if(d < 10) stream << ('0' + $u8 d);
        else stream << ('a' + $u8 (d - 10));
        x <<= 0x4;
    }
    return stream;
}

ostream& operator<<(ostream& stream, ed25519_pt pt) {
    return stream << "(" << pt.x() << ", " << pt.y() << ")";
}
